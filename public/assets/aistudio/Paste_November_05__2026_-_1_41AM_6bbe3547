>> pub fn aggregate_private_memory_tree(
>>     root_pid: u32,
>>     snapshot: &[ProcessSample],
>> ) -> ProcessTreePrivateMemory {
>>     let mut visited = HashSet::new();
>>     let mut queue = VecDeque::new();
>>     queue.push_back(root_pid);
>>     visited.insert(root_pid);
>>
>>     let mut process_count = 0usize;
>>     let mut webview2_child_count = 0usize;
>>     let mut total_private_bytes = 0u64;
>>     let mut tree_identities = Vec::new();
>>
>>     while let Some(current_pid) = queue.pop_front() {
>>         for node in snapshot {
>>             if node.pid == current_pid {
>>                 process_count += 1;
>>                 total_private_bytes = total_private_bytes.saturating_add(node.private_bytes);
>>                 tree_identities.push(node.identity());
>>                 if node.pid != root_pid
>>                     && node.name.to_ascii_lowercase().contains("msedgewebview2")
>>                 {
>>                     webview2_child_count += 1;
>>                 }
>>             }
>>             if node.parent_pid == current_pid && !visited.contains(&node.pid) {
>>                 visited.insert(node.pid);
>>                 queue.push_back(node.pid);
>>             }
>>         }
>>     }
>>
>>     ProcessTreePrivateMemory {
>>         root_pid,
>>         process_count,
>>         webview2_child_count,
>>         total_private_bytes,
>>         tree_identities,
>>     }
>> }
