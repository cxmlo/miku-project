>> pub fn format_step01_table(rows: &[Step01ReportRow]) -> String {
>>     let mut out = String::new();
>>     out.push_str("| Paso | Modo / Prueba (root_pid = hijo lanzado) | Memoria Comprometida Privada `PrivatePageCount` (p50 / p95) | Latencia (p50 / p95) | Huérfanos `(pid, name)` | Estado / Veredicto |\n");
>>     out.push_str("|---|---|---|---|---|---|\n");
>>
>>     for row in rows {
>>         let ram_str = format_metric_cell(&row.private_ram_mb, "MB");
>>         let lat_str = format_metric_cell(&row.latency_ms, "ms");
>>         let orphan_str = match &row.surviving_orphans_after_close {
>>             Some(list) if list.is_empty() => "0 (OK)".to_string(),
>>             Some(list) => format!("{} (FALLO: {:?})", list.len(), list),
>>             None => "PENDIENTE-LOCAL".to_string(),
>>         };
>>
>>         let verdict = match (
>>             &row.evaluation_kind,
>>             &row.private_ram_mb,
>>             &row.latency_ms,
>>             &row.surviving_orphans_after_close,
>>         ) {
>>             (
>>                 RowEvaluationKind::CalibrationReference,
>>                 MetricCell::Measured { .. },
>>                 MetricCell::Measured { .. },
>>                 Some(list),
>>             ) if list.is_empty() => STEP_01A_REFERENCE_VERDICT,
>>             (
>>                 RowEvaluationKind::ProductModeThreshold,
>>                 MetricCell::Measured { stats: ram, .. },
>>                 MetricCell::Measured { stats: lat, .. },
>>                 Some(list),
>>             ) if list.is_empty() => {
>>                 if ram.median_p50 <= MAX_IDLE_PRIVATE_MB
>>                     && lat.p95 <= MAX_HOVER_TO_VISIBLE_P95_MS
>>                 {
>>                     "MEDIDO (CUMPLE <=30 MB y p95<=150 ms)"
>>                 } else {
>>                     "MEDIDO (EXCEDE UMBRAL)"
>>                 }
>>             }
>>             _ => "PENDIENTE-LOCAL (Se mide en 0.1b)",
>>         };
>>
>>         out.push_str(&format!(
>>             "| `{}` | {} | {} | {} | {} | **{}** |\n",
>>             row.step_id, row.label, ram_str, lat_str, orphan_str, verdict
>>         ));
>>     }
>>
>>     out
>> }
