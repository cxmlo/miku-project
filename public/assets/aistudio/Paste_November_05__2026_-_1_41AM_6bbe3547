>> pub fn verify_report_provenance(rows: &[Step01ReportRow]) -> Result<(), VerificationError> {
>>     if rows.is_empty() {
>>         return Err(VerificationError::EmptyReport);
>>     }
>>     let mut has_at_least_one_measured_row = false;
>>
>>     for row in rows {
>>         for (is_ram, cell) in [(true, &row.private_ram_mb), (false, &row.latency_ms)] {
>>             if let MetricCell::Measured {
>>                 stats,
>>                 provenance_pid,
>>                 provenance_present_in_snapshot,
>>                 min_tree_process_count,
>>                 os_probe,
>>             } = cell
>>             {
>>                 has_at_least_one_measured_row = true;
>>                 if stats.sample_count != REQUIRED_REPETITIONS {
>>                     return Err(VerificationError::InvalidSampleCount {
>>                         row_label: row.label.clone(),
>>                         found: stats.sample_count,
>>                         expected: REQUIRED_REPETITIONS,
>>                     });
>>                 }
>>                 if *provenance_pid == 0 {
>>                     return Err(VerificationError::ZeroProvenancePid {
>>                         row_label: row.label.clone(),
>>                     });
>>                 }
>>                 if !*provenance_present_in_snapshot {
>>                     return Err(VerificationError::ProvenancePidNotInSnapshot {
>>                         row_label: row.label.clone(),
>>                         pid: *provenance_pid,
>>                     });
>>                 }
>>                 if *min_tree_process_count < 2 {
>>                     return Err(VerificationError::TreeMissingDescendant {
>>                         row_label: row.label.clone(),
>>                         min_process_count: *min_tree_process_count,
>>                     });
>>                 }
>>                 if os_probe.trim().is_empty() {
>>                     return Err(VerificationError::EmptyOsProbe {
>>                         row_label: row.label.clone(),
>>                     });
>>                 }
>>                 if !stats.median_p50.is_finite()
>>                     || !stats.p95.is_finite()
>>                     || stats.median_p50 < 0.0
>>                     || stats.p95 < 0.0
>>                 {
>>                     return Err(VerificationError::NonFiniteMeasurement {
>>                         row_label: row.label.clone(),
>>                     });
>>                 }
>>                 if is_ram && stats.median_p50 <= 0.0 {
>>                     return Err(VerificationError::ZeroPrivateBytesMeasured {
>>                         row_label: row.label.clone(),
>>                     });
>>                 }
>>             }
>>         }
>>
>>         if let Some(orphans) = &row.surviving_orphans_after_close {
>>             if !orphans.is_empty() {
>>                 return Err(VerificationError::OrphanProcessesRemaining {
>>                     row_label: row.label.clone(),
>>                     orphans: orphans.clone(),
>>                 });
>>             }
>>         }
>>     }
>>
>>     if !has_at_least_one_measured_row {
>>         return Err(VerificationError::EmptyReport);
>>     }
>>     Ok(())
>> }
