>> pub fn parse_tsv_process_line(line: &str) -> Option<ProcessSample> {
>>     let trimmed = line.trim();
>>     if trimmed.is_empty() {
>>         return None;
>>     }
>>     let cols: Vec<String> = trimmed
>>         .split('\t')
>>         .map(|raw| {
>>             let s = raw.trim();
>>             if s.len() >= 2 && s.starts_with('"') && s.ends_with('"') {
>>                 s[1..s.len() - 1].replace("\"\"", "\"")
>>             } else {
>>                 s.to_string()
>>             }
>>         })
>>         .collect();
>>
>>     if cols.len() < 4 {
>>         return None;
>>     }
>>
>>     let pid = cols[0].parse::<u32>().ok()?;
>>     if pid == 0 {
>>         return None;
>>     }
>>     let parent_pid = cols[1].parse::<u32>().ok()?;
>>     let name = cols[2].clone();
>>     let private_bytes = cols[3].parse::<u64>().ok()?;
>>
>>     Some(ProcessSample { pid, parent_pid, name, private_bytes })
>> }
