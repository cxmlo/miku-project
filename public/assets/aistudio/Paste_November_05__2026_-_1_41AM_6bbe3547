>> pub fn compute_distribution_stats(samples: &[f64]) -> Option<DistributionStats> {
>>     if samples.is_empty() || samples.iter().any(|v| !v.is_finite()) {
>>         return None;
>>     }
>>     let mut sorted = samples.to_vec();
>>     sorted.sort_by(|a, b| a.partial_cmp(b).unwrap_or(std::cmp::Ordering::Equal));
>>     let len = sorted.len();
>>     let median_p50 = if len % 2 == 1 {
>>         sorted[len / 2]
>>     } else {
>>         (sorted[(len / 2) - 1] + sorted[len / 2]) / 2.0
>>     };
>>     let idx_p95 = ((len as f64 * 0.95).ceil() as usize).saturating_sub(1).min(len - 1);
>>     Some(DistributionStats {
>>         sample_count: len,
>>         min: sorted[0],
>>         median_p50,
>>         p95: sorted[idx_p95],
>>         max: sorted[len - 1],
>>     })
>> }
