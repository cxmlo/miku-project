>> pub fn format_metric_cell(cell: &MetricCell, unit: &str) -> String {
>>     match cell {
>>         MetricCell::Measured { stats, .. } => format!(
>>             "p50={:.2} {} / p95={:.2} {} (n={})",
>>             stats.median_p50, unit, stats.p95, unit, stats.sample_count
>>         ),
>>         MetricCell::PendingLocal { reason } => format!("PENDIENTE-LOCAL ({})", reason),
>>     }
>> }
