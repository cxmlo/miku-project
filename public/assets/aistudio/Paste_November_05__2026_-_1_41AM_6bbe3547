>> pub fn find_surviving_spawned_identities(
>>     spawned_identities: &HashSet<ProcessIdentity>,
>>     post_close_snapshot: &[ProcessSample],
>> ) -> Vec<ProcessIdentity> {
>>     let mut surviving = Vec::new();
>>     for sample in post_close_snapshot {
>>         let id = sample.identity();
>>         if spawned_identities.contains(&id) && !surviving.contains(&id) {
>>             surviving.push(id);
>>         }
>>     }
>>     surviving.sort_by_key(|item| item.pid);
>>     surviving
>> }
